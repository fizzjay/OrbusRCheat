<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FlatOrbus</AssemblyName>
    <RootNamespace>FlatOrbus</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\OrbusVR</GameDir>
    <MelonDir Condition="'$(MelonDir)' == ''">$(GameDir)\MelonLoader</MelonDir>
    <MelonRuntimeDir Condition="'$(MelonRuntimeDir)' == ''">$(MelonDir)\net6</MelonRuntimeDir>
    <InteropDir Condition="'$(InteropDir)' == ''">$(MelonDir)\Il2CppAssemblies</InteropDir>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(MelonRuntimeDir)\MelonLoader.dll" />
    <Reference Include="0Harmony" HintPath="$(MelonRuntimeDir)\0Harmony.dll" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(MelonRuntimeDir)\Il2CppInterop.Runtime.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(InteropDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(InteropDir)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(InteropDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(InteropDir)\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(InteropDir)\UnityEngine.UIModule.dll" />
    <Reference Include="UnityEngine.XRModule" HintPath="$(InteropDir)\UnityEngine.XRModule.dll" />
  </ItemGroup>
</Project>
